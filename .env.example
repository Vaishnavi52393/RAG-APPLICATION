# ==============================================================================
# Cloud-Based RAG Document Assistant - Environment Variables
# ==============================================================================

# Google Gemini API Key (Required)
# Obtain your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy..."

# Embedding Model Configuration
# Supported: gemini-embedding-2-preview, text-embedding-004
EMBEDDING_MODEL="gemini-embedding-2-preview"

# Generation Model Configuration
# Supported: gemini-3.8-flash, gemini-4-argon
GENERATION_MODEL="gemini-3.8-flash"

# ChromaDB Vector Storage Directory (Local persistent vector database)
CHROMA_PERSIST_DIR="./chroma_db"

# Server / Streamlit Configuration (Port 8080 for Cloud Run, 3000/8501 for local)
PORT=8080
STREAMLIT_SERVER_PORT=8080
STREAMLIT_SERVER_ADDRESS="0.0.0.0"

# Optional Google Cloud Project ID for Vertex AI Gemini integrations
GOOGLE_CLOUD_PROJECT="my-gcp-project-id"
GOOGLE_CLOUD_REGION="us-central1"

# App URL (Injected automatically in Cloud Run / AI Studio)
APP_URL="http://localhost:8080"

